# Copy to .env and fill in real values. Never commit .env.
GOOGLE_API_KEY=

# Optional: only needed to attempt REAL posting instead of staging locally.
# Leave blank to always stage for manual review/approval.
META_PAGE_ACCESS_TOKEN=
META_IG_USER_ID=
META_PAGE_ID=

# When set to 1, tools return mock/placeholder output -- zero API spend.
MARKETING_MOCK=0
